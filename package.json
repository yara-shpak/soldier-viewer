{
  "name": "soldier-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "pipeline": ".venv/bin/python pipeline/build.py",
    "qa:screens": "node tests/screens.mjs",
    "qa:zones": "node tests/zones.mjs",
    "qa:polish": "node tests/polish.mjs",
    "qa:browsers": "node tests/browsers.mjs",
    "qa:weight": "node tests/weight.mjs",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "qa:embed": "node tests/embed.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "lil-gui": "0.21.0",
    "playwright": "1.64.1",
    "svgo": "3.3.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "three": "0.186.1"
  }
